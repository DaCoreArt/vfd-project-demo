% Add one entry per source, then cite it inline using its key in
% square brackets — see README.md for the exact syntax.
% MyST renders the reference list automatically.
%
% NOTE: never put an "at" sign inside a comment line here. MyST's
% BibTeX parser reads it as the start of an entry and the file fails.

@article{REPLACEcitekey,
  author  = {REPLACE - Last, First},
  title   = {REPLACE - Article title},
  journal = {REPLACE - Journal name},
  volume  = {0},
  number  = {0},
  pages   = {0--0},
  year    = {2026},
  url     = {https://REPLACE}
}

@misc{REPLACEweb,
  author  = {{REPLACE - Organization}},
  title   = {REPLACE - Page or report title},
  year    = {2026},
  url     = {https://REPLACE},
  urldate = {2026-08-26}
}
